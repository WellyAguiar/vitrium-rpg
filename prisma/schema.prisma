generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(cuid())
  name       String
  email      String      @unique
  password   String
  role       UserRole
  campaigns  Campaign[]
  characters Character[]
}

model Campaign {
  id         String      @id @default(cuid())
  name       String
  createdBy  String
  creator    User        @relation(fields: [createdBy], references: [id])
  characters Character[]
}

model Character {
  id                String           @id @default(cuid())
  name              String
  userId            String?
  campaignId        String?
  forca             Int
  agilidade         Int
  intelecto         Int
  presenca          Int
  vontade           Int
  vidaAtual         Int
  eterAtual         Int
  corrupcao         Int
  combate           Int
  atletismo         Int
  intimidacaoFisica Int
  mira              Int
  furtividade       Int
  reflexos          Int
  investigacao      Int
  manutencao        Int
  conhecimento      Int
  persuasao         Int
  enganacao         Int
  intimidacaoVerbal Int
  resistencia       Int
  determinacao      Int
  intuicao          Int
  campaign          Campaign?        @relation(fields: [campaignId], references: [id])
  user              User?            @relation(fields: [userId], references: [id])
  notes             Note[]
  specialAbilities  SpecialAbility[]
}

model SpecialAbility {
  id          String      @id @default(cuid())
  characterId String
  name        String
  description String
  type        AbilityType
  eterCost    Int
  corrCost    Int
  character   Character   @relation(fields: [characterId], references: [id])
}

model Note {
  id          String    @id @default(cuid())
  characterId String
  content     String
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id])
}

enum UserRole {
  PLAYER
  MASTER
}

enum AbilityType {
  PASSIVE
  ACTIVE
  RISK
}
